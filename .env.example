# ClickHouse Database Configuration
DB_HOST=localhost
DB_PORT=8123
DB_USER=finuser
DB_PASSWORD=finpassword
DB_NAME=finance_db

# Qdrant Vector Search Engine Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=financial_reports
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3

# Redis Cache & Checkpointer Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka Broker & Topic Streaming Configuration
KAFKA_BROKER=localhost:9092
TOPIC_MARKET=finagent_bronze_market
TOPIC_NEWS=finagent_bronze_news
TOPIC_MARKET_DLQ=finagent_market_dlq
TOPIC_NEWS_DLQ=finagent_news_dlq

# Langfuse LLM Observability Configuration
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key_here
LANGFUSE_HOST=http://localhost:3000

# Langfuse PostgreSQL Infrastructure (Docker Compose)
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=secret_password
LANGFUSE_DB_NAME=langfuse
NEXTAUTH_SECRET=secret_salt_string_for_auth_encryption
SALT=secret_salt_for_password_hashing

# Telegram Bot Interface Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Local LLM Models (Ollama)
LLM_CODER_MODEL=qwen2.5-coder:1.5b-instruct
LLM_ANALYST_MODEL=qwen2.5:1.5b-instruct
LLM_GUARD_MODEL=llama-guard3:1b-q5_K_S

# Multi-Provider Cloud LLM Settings (Optional: local / cloud)
ANALYST_LLM_PROVIDER=local
ANALYST_TEMPERATURE=0.3
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
GROQ_API_KEY=your_groq_api_key
ANALYST_API_MODEL=gpt-4o-mini
ANALYST_API_BASE_URL=

# Semantic Router & Memory Budget
MAX_HISTORY_TOKENS=800
MAX_HISTORY_MESSAGES=20
SEMANTIC_ROUTER_THRESHOLD=0.55

# Vnstock Market Data API Key
VNSTOCK_API_KEY=your_vnstock_api_key
